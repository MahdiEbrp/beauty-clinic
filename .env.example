# Canonical public origin, no trailing slash.
# Used for canonical URLs, hreflang, sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://beauty-clinic-puce-five.vercel.app

# --- Database (PostgreSQL) ---
# Runtime connection (transaction pooler on Supabase). One connection per request.
DATABASE_URL=postgres://user:password@host:6543/postgres?sslmode=require
# Direct connection used ONLY by drizzle-kit migrations.
DIRECT_URL=postgres://user:password@host:5432/postgres?sslmode=require

# Scheduled slot auto-generator (croner via instrumentation.ts). Set to "false"
# to disable the in-process daily job. Defaults to enabled outside development.
SLOTS_CRON_ENABLED=true

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# --- Encryption ---
# 64-char hex key for AES-256-GCM at-rest encryption (TOTP secret, etc).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# --- Rate limiting (optional) ---
# Shared Redis-backed limiter so rate limits hold across serverless instances.
# Either the Vercel KV pair or the Upstash pair works; when both are absent,
# rate limiting falls back to an in-process store (single instance only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Client IP is read from platform-set headers only (x-vercel-forwarded-for,
# cf-connecting-ip, x-real-ip). Set TRUST_PROXY=1 only for deployments behind a
# reverse proxy you control that overwrites x-forwarded-for.
# TRUST_PROXY=1

# --- Seeding (optional) ---
# Superuser created by `pnpm db:seed` (real values live in .env.local). When
# SEED_ADMIN_EMAIL targets an already-seeded "Super Admin" account, the seed
# renames that account to the new address instead of creating a duplicate.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me
# SEED_ADMIN_PHONE=

# Optional default email provider seeded as the active sender. When both are
# set, a Gmail SMTP provider (smtp.gmail.com:465, SSL) is created/updated with
# these credentials and becomes the default; otherwise the fake sender stays.
# SEED_GMAIL_USERNAME=you@gmail.com
# SEED_GMAIL_PASSWORD=your-gmail-app-password
# SEED_GMAIL_FROM_NAME=

# --- File manager storage (self-hosted) ---
# Root directory for managed files. Defaults to ./public so the manager browses
# the served public tree directly (e.g. the images/ and fonts/ folders). Only
# put safe public assets here — anything uploaded is served inline from the same
# origin. Internal metadata (trash, staged uploads) lives outside the served
# tree in .file-manager.
# FILE_STORAGE_ROOT=./public
# Maximum upload size in bytes (default 50 MiB).
# FILE_MAX_BYTES=52428800
